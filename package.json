{
  "name": "open-mosaik",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter tv dev",
    "build": "pnpm -r build",
    "gen:types": "cargo test -p om-core --features ts export_bindings",
    "tauri": "tauri",
    "fmt": "cargo fmt --all && prettier --write .",
    "fmt:check": "cargo fmt --all --check && prettier --check .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "cargo test --workspace --all-features && pnpm -r test",
    "commitlint": "commitlint",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
