# Variables d'environnement d'Open Mosaik (développement et CI).
#
# L'application ne lit aucun fichier `.env` : ces variables doivent être
# exportées dans le shell qui lance l'application (`export OPEN_MOSAIK_…=…`).
#
# Priorité des réglages : variable d'environnement, puis valeur enregistrée,
# puis valeur par défaut. Une variable définie et valide verrouille le réglage
# correspondant dans l'écran Paramètres, avec la raison affichée, et les
# modifications depuis l'interface sont refusées. Une valeur invalide est
# ignorée avec un avertissement.
#
# Voir docs/adr/0008-configuration-a-chaud-et-invariants.md.

# Interface : barre de titre de la fenêtre. Booléen (true, false, 1, 0). Défaut : true.
# OPEN_MOSAIK_INTERFACE_WINDOW_DECORATIONS=true

# Réseau : délai d'attente d'une réponse, en millisecondes.
# Entier de 1000 à 60000, par pas de 500. Défaut : 10000.
# OPEN_MOSAIK_NETWORK_TIMEOUT_MS=10000

# Médiathèque : nombre de dossiers analysés simultanément.
# Entier de 1 à 8. Défaut : 2.
# OPEN_MOSAIK_LIBRARY_SCAN_PARALLELISM=2

# Lecture : décodage matériel de la vidéo. Booléen. Défaut : true.
# OPEN_MOSAIK_PLAYBACK_HARDWARE_DECODING=true

# Configuration : premier lancement terminé. Booléen. Défaut : false.
# Réglage masqué dans l'écran Paramètres : une variable définie le verrouille sans l'afficher.
# OPEN_MOSAIK_SETUP_FIRST_RUN_COMPLETED=false

# Secret : clé de l'API TMDB. Texte non vide. Pas de valeur par défaut.
# Une variable non vide verrouille la clé dans l'écran et court-circuite le
# trousseau du système : sans trousseau, c'est la seule façon de la fournir.
# La clé n'est jamais affichée par l'application.
# OPEN_MOSAIK_TMDB_API_KEY=
